{
  "name": "no-code-builder",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:web": "pnpm --filter @ncb/web dev",
    "dev:engine": "pnpm --filter @ncb/engine dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @ncb/db generate",
    "db:migrate": "pnpm --filter @ncb/db migrate"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
