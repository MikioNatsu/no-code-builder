# Copy to .env and fill in. Never commit .env.

# PostgreSQL
POSTGRES_USER=ncb
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ncb
DATABASE_URL=postgres://ncb:change-me@localhost:5432/ncb

# Redis
REDIS_URL=redis://localhost:6379

# 32-byte key, base64. Generate with: openssl rand -base64 32
# Used to encrypt bot tokens at rest. Losing it makes stored tokens unreadable.
TOKEN_ENCRYPTION_KEY=

# Self-hosted Telegram Bot API server (https://my.telegram.org -> API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
BOT_API_URL=http://localhost:8081

# Public base URL that Telegram sends webhooks to (must be HTTPS in production)
PUBLIC_WEBHOOK_BASE_URL=https://example.com
ENGINE_PORT=3001
